# Copy this file to .env (same folder) and fill in real values.
# .env is ignored by git — never commit it.

# --- Database (Azure MySQL) ---
DB_HOST=your-server.mysql.database.azure.com
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=recipe_db
# TLS is on and certificates are verified by default.
# Only if you get a certificate error, set this to false temporarily:
# DB_SSL_REJECT_UNAUTHORIZED=false

# --- OpenAI (recipe parsing, photo reading, ingredient matching) ---
OPENAI_API_KEY=sk-...
# Must be a vision-capable model for photo import.
OPENAI_MODEL=gpt-4o-mini

# --- Server ---
PORT=5000
# Comma-separated list of sites allowed to call the API.
# Leave empty during local development to allow any origin.
ALLOWED_ORIGINS=http://localhost:3000,https://your-site.netlify.app
